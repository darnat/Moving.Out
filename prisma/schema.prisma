generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  storageUnit   StorageUnit?
  boxSizes      BoxSize[]
  rooms         Room[]
  boxes         Box[]
}

model StorageUnit {
  id          String @id @default(cuid())
  userId      String @unique
  widthCells  Int    @default(10)
  depthCells  Int    @default(20)
  heightCells Int    @default(8)
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BoxSize {
  id          String  @id @default(cuid())
  userId      String
  name        String
  widthIn     Int
  depthIn     Int
  heightIn    Int
  widthCells  Int
  depthCells  Int
  heightCells Int
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  boxes       Box[]
}

model Room {
  id     String @id @default(cuid())
  userId String
  name   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  boxes  Box[]
}

model Box {
  id          String  @id @default(cuid())
  labelNumber String
  qrCode      String?
  userId      String
  roomId      String
  boxSizeId   String
  gridCol     Float?
  gridRow     Float?
  stackLevel  Float?
  retrieved   Boolean @default(false)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  room        Room    @relation(fields: [roomId], references: [id])
  boxSize     BoxSize @relation(fields: [boxSizeId], references: [id])
  items       Item[]
  photos      Photo[]
}

model Item {
  id    String @id @default(cuid())
  boxId String
  name  String
  box   Box    @relation(fields: [boxId], references: [id], onDelete: Cascade)
}

model Photo {
  id        String   @id @default(cuid())
  boxId     String
  url       String
  createdAt DateTime @default(now())
  box       Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
}
